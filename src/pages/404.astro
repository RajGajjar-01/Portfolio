---
import Page from '../layouts/Page.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<Page title="Not found" noindex header={false} footer={false}>
	<Container class="flex min-h-[60svh] flex-col justify-center py-24">
		<p class="text-muted mb-4 font-mono text-xs tracking-widest uppercase">404</p>
		<h1 class="text-4xl sm:text-6xl">This page does not exist.</h1>
		<p class="text-muted mt-6 max-w-md text-lg leading-relaxed">
			The link may be out of date, or the page may have moved.
		</p>

		<div class="mt-10 flex flex-wrap gap-3">
			<Button href="/">Home</Button>
			<Button href="/projects" variant="outline">Work</Button>
			<Button href="/blog" variant="ghost">Writing</Button>
		</div>
	</Container>
</Page>
