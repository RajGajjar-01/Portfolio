---
import Page from '../layouts/Page.astro';
import Section from '../components/ui/Section.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import Contact from '../components/home/Contact.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import PostCard from '../components/ui/PostCard.astro';
import { getFeaturedProjects, getPosts } from '../lib/content';

const projects = await getFeaturedProjects(3);
const posts = (await getPosts()).slice(0, 3);
---

<Page>
	<Hero />

	{
		projects.length > 0 && (
			<Section
				eyebrow="Selected work"
				title="Things I have built"
				action={{ label: 'All work', href: '/projects' }}
			>
				<div class="grid gap-x-8 gap-y-14 sm:grid-cols-2">
					{projects.map((project, i) => (
						<ProjectCard project={project} eager={i === 0} />
					))}
				</div>
			</Section>
		)
	}

	<About />

	{
		posts.length > 0 && (
			<Section
				eyebrow="Writing"
				title="Recent posts"
				action={{ label: 'All posts', href: '/blog' }}
			>
				<div>
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			</Section>
		)
	}

	<Contact />
</Page>
