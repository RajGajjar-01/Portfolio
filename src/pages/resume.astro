---
import Page from '../layouts/Page.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';
import { site, socials } from '../data/site';
import { experience, skills, resumePdf, type ResumeItem } from '../data/resume';

const sections: { heading: string; items: ResumeItem[] }[] = [{ heading: 'Experience', items: experience }];
---

<Page title="Resume" description={`Resume and background for ${site.name}.`}>
	<Container class="py-16 sm:py-24">
		<header class="border-border mb-14 border-b pb-10">
			<h1 class="text-4xl sm:text-6xl">{site.name}</h1>
			<p class="text-muted mt-3 text-lg">{site.role}</p>

			<div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
				<a href={`mailto:${site.email}`} class="text-muted hover:text-fg transition-colors">
					{site.email}
				</a>
				{
					socials
						.filter((s) => s.label !== 'Email')
						.map((s) => (
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer"
								class="text-muted hover:text-fg transition-colors"
							>
								{s.label}
							</a>
						))
				}
			</div>

			{
				resumePdf && (
					<div class="mt-8 print:hidden">
						<Button href={resumePdf} variant="outline">
							Download PDF
						</Button>
					</div>
				)
			}
		</header>

		{
			sections.map(({ heading, items }) => (
				<section class="mb-14">
					<h2 class="text-muted mb-8 font-mono text-xs tracking-widest uppercase">
						{heading}
					</h2>

					<div class="space-y-10">
						{items.map((item) => (
							<div class="reveal grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-8">
								<p class="text-muted pt-1 font-mono text-xs">
									{item.end && item.end !== item.start ? `${item.start} – ${item.end}` : item.end ? item.start : `${item.start} – Present`}
								</p>

								<div>
									<h3 class="text-xl">{item.title}</h3>
									<p class="text-muted mt-1 text-sm">
										{item.org}
										{item.location && ` · ${item.location}`}
									</p>

									{item.summary && (
										<p class="text-muted mt-3 max-w-prose text-sm leading-relaxed">
											{item.summary}
										</p>
									)}

									{item.points && (
										<ul class="mt-3 max-w-prose space-y-2">
											{item.points.map((point) => (
												<li class="text-muted flex gap-2.5 text-sm leading-relaxed">
													<span class="text-accent mt-2 size-1 shrink-0 rounded-full bg-current" />
													<span>{point}</span>
												</li>
											))}
										</ul>
									)}
								</div>
							</div>
						))}
					</div>
				</section>
			))
		}

		<section>
			<h2 class="text-muted mb-8 font-mono text-xs tracking-widest uppercase">Skills</h2>

			<div class="space-y-6">
				{
					skills.map(({ group, items }) => (
						<div class="reveal grid gap-2 sm:grid-cols-[10rem_1fr] sm:gap-8">
							<p class="text-muted pt-0.5 font-mono text-xs">{group}</p>
							<div class="flex flex-wrap gap-2">
								{items.map((item) => (
									<Tag>{item}</Tag>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>
	</Container>
</Page>

<style>
	/* Printing the page should produce a usable resume. */
	@media print {
		:global(header[class*='sticky']),
		:global(footer) {
			display: none;
		}
	}
</style>
