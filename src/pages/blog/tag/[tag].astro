---
import type { GetStaticPaths } from 'astro';
import Page from '../../../layouts/Page.astro';
import Container from '../../../components/ui/Container.astro';
import PostCard from '../../../components/ui/PostCard.astro';
import { getPosts, getPostTags, tagSlug } from '../../../lib/content';

export const getStaticPaths = (async () => {
	const [posts, tags] = await Promise.all([getPosts(), getPostTags()]);

	return tags.map(({ tag }) => ({
		params: { tag: tagSlug(tag) },
		props: {
			tag,
			posts: posts.filter((post) => post.data.tags.includes(tag)),
		},
	}));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<Page
	title={`Posts tagged “${tag}”`}
	description={`Writing tagged ${tag}: ${posts.length} post${posts.length === 1 ? '' : 's'}.`}
>
	<Container class="section-y">
		<header class="mb-14">
			<a
				href="/blog"
				class="text-muted hover:text-fg group mb-8 inline-flex items-center gap-1.5 text-sm transition-colors"
			>
				<span class="inline-block transition-transform group-hover:-translate-x-0.5">&larr;</span>
				All posts
			</a>

			<p class="eyebrow mb-3">Tag</p>
			<h1 class="display-title">{tag}</h1>
			<p class="text-muted mt-4 text-sm">
				{posts.length} post{posts.length === 1 ? '' : 's'}
			</p>
		</header>

		<div>
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</Container>
</Page>
