---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Entry from '../../layouts/Entry.astro';
import Container from '../../components/ui/Container.astro';
import PostCard from '../../components/ui/PostCard.astro';
import { getPosts, tagSlug } from '../../lib/content';

export const getStaticPaths = (async () => {
	const posts = await getPosts();

	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			// Precomputed here so the page itself does no querying.
			related: posts.filter((p, j) => j !== i && p.data.tags.some((t) => post.data.tags.includes(t))).slice(0, 2),
		},
	}));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props;
const { title, description, pubDate, updatedDate, cover, coverAlt, tags } = post.data;
const { Content } = await render(post);
---

<Entry
	title={title}
	description={description}
	heading={title}
	lede={description}
	date={pubDate}
	updatedDate={updatedDate}
	tags={tags}
	tagHref={(tag) => `/blog/tag/${tagSlug(tag)}`}
	back={{ label: 'All posts', href: '/blog' }}
	article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags: [...tags] }}
>
	<Fragment slot="hero">
		{
			cover && (
				<div class="border-border bg-surface mb-14 overflow-hidden rounded-xl border">
					<Image
						src={cover}
						alt={coverAlt}
						width={1600}
						height={900}
						loading="eager"
						fetchpriority="high"
						class="aspect-video w-full object-cover"
					/>
				</div>
			)
		}
	</Fragment>

	<Content />

	{
		related.length > 0 && (
			<Container slot="after" class="border-border mt-16 border-t py-12">
				<h2 class="mb-8 text-2xl">Related</h2>
				{related.map((p) => (
					<PostCard post={p} />
				))}
			</Container>
		)
	}
</Entry>
