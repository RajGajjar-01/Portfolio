---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Entry from '../../layouts/Entry.astro';
import Button from '../../components/ui/Button.astro';
import Container from '../../components/ui/Container.astro';
import { getProjects } from '../../lib/content';
import { breadcrumbSchema, projectSchema } from '../../lib/schema';

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	return projects.map((project, i) => ({
		params: { slug: project.id },
		// Wraps around, so the last project points back to the first.
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { title, summary, cover, coverAlt, tags, year, role, link, repo } = project.data;
const { Content } = await render(project);

const canonical = new URL(`/projects/${project.id}/`, Astro.site);
---

<Entry
	title={title}
	description={summary}
	heading={title}
	lede={summary}
	tags={tags}
	image={cover?.src}
	imageAlt={cover ? coverAlt : undefined}
	schema={[
		projectSchema(project, canonical, cover?.src),
		breadcrumbSchema([
			{ name: 'Home', path: '/' },
			{ name: 'Work', path: '/projects/' },
			{ name: title },
		]),
	]}
>
	<Fragment slot="meta">
		<span>{year}</span>
		{role && <span>{role}</span>}
	</Fragment>

	<Fragment slot="hero">
		{
			cover && (
				<div class="border-border bg-surface mb-14 overflow-hidden border">
					<Image
						src={cover}
						alt={coverAlt}
						width={1600}
						height={1000}
						loading="eager"
						fetchpriority="high"
						class="aspect-[8/5] w-full object-cover"
					/>
				</div>
			)
		}

		{
			(link || repo) && (
				<div class="mb-14 flex flex-wrap gap-3">
					{link && <Button href={link}>Visit site</Button>}
					{repo && (
						<Button href={repo} variant="outline">
							Source
						</Button>
					)}
				</div>
			)
		}
	</Fragment>

	<Content />

	<Container slot="after" class="mt-16">
		<nav aria-label="More work" class="border-border border-t pt-12 pb-16">
			{
				next.id !== project.id && (
					<a
						href={`/projects/${next.id}`}
						class="group grid items-center gap-8 sm:grid-cols-[1fr_minmax(0,22rem)]"
					>
						<div>
							<p class="eyebrow mb-4">Next project</p>
							<p class="group-hover:text-accent text-3xl leading-tight transition-colors sm:text-5xl">
								{next.data.title.split(':')[0]}
							</p>
							<p class="text-muted mt-4 max-w-xl leading-relaxed">{next.data.summary}</p>
						</div>
						{next.data.cover && (
							<div class="border-border overflow-hidden border transition-colors duration-300 group-hover:border-[color-mix(in_oklch,var(--muted)_45%,transparent)]">
								<Image
									src={next.data.cover}
									alt=""
									width={704}
									height={440}
									class="aspect-[8/5] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
								/>
							</div>
						)}
					</a>
				)
			}
			<a
				href="/projects"
				class="text-muted hover:text-fg mt-12 inline-block text-sm underline decoration-[var(--border)] underline-offset-4 transition-colors hover:decoration-current"
			>
				All work
			</a>
		</nav>
	</Container>
</Entry>
