---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Entry from '../../layouts/Entry.astro';
import Button from '../../components/ui/Button.astro';
import Container from '../../components/ui/Container.astro';
import { getProjects, tagSlug } from '../../lib/content';

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, summary, cover, coverAlt, tags, year, role, link, repo } = project.data;
const { Content } = await render(project);

// Matches the card on the listing page, so the cover morphs between them.
const transitionName = `cover-${tagSlug(project.id)}`;
---

<Entry
	title={title}
	description={summary}
	heading={title}
	lede={summary}
	tags={tags}
	back={{ label: 'All work', href: '/projects' }}
>
	<Fragment slot="meta">
		<span>{year}</span>
		{role && <span>{role}</span>}
	</Fragment>

	<Fragment slot="hero">
		{
			cover && (
				<div class="border-border bg-surface mb-14 overflow-hidden rounded-xl border">
					<Image
						src={cover}
						alt={coverAlt}
						width={1600}
						height={1000}
						loading="eager"
						fetchpriority="high"
						class="aspect-[8/5] w-full object-cover"
						style={`view-transition-name: ${transitionName}`}
					/>
				</div>
			)
		}

		{
			(link || repo) && (
				<div class="mb-14 flex flex-wrap gap-3">
					{link && <Button href={link}>Visit site</Button>}
					{repo && (
						<Button href={repo} variant="outline">
							Source
						</Button>
					)}
				</div>
			)
		}
	</Fragment>

	<Content />

	<Container slot="after" class="border-border mt-16 border-t py-12">
		<a href="/projects" class="text-muted hover:text-fg text-sm transition-colors">
			&larr; All work
		</a>
	</Container>
</Entry>
