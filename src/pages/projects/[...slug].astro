---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Entry from '../../layouts/Entry.astro';
import Button from '../../components/ui/Button.astro';
import Container from '../../components/ui/Container.astro';
import { getProjects } from '../../lib/content';
import { breadcrumbSchema, projectSchema } from '../../lib/schema';

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	return projects.map((project, i) => ({
		params: { slug: project.id },
		// Wraps around, so the last project points back to the first.
		props: { project, next: projects[(i + 1) % projects.length] },
	}));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { title, summary, cover, coverAlt, tags, year, role, link, repo } = project.data;
const { Content } = await render(project);

const canonical = new URL(`/projects/${project.id}/`, Astro.site);
---

<Entry
	title={title}
	description={summary}
	heading={title}
	lede={summary}
	tags={tags}
	image={cover?.src}
	imageAlt={cover ? coverAlt : undefined}
	schema={[
		projectSchema(project, canonical, cover?.src),
		breadcrumbSchema([
			{ name: 'Home', path: '/' },
			{ name: 'Work', path: '/projects/' },
			{ name: title },
		]),
	]}
>
	<Fragment slot="meta">
		<span>{year}</span>
		{role && <span>{role}</span>}
	</Fragment>

	<Fragment slot="hero">
		{
			cover && (
				<div class="border-border bg-surface mb-14 overflow-hidden border">
					<Image
						src={cover}
						alt={coverAlt}
						width={1600}
						height={1000}
						loading="eager"
						fetchpriority="high"
						class="aspect-[8/5] w-full object-cover"
					/>
				</div>
			)
		}

		{
			(link || repo) && (
				<div class="mb-14 flex flex-wrap gap-3">
					{link && <Button href={link}>Visit site</Button>}
					{repo && (
						<Button href={repo} variant="outline">
							Source
						</Button>
					)}
				</div>
			)
		}
	</Fragment>

	<Content />

	<Container slot="after" class="mt-16">
		<nav
			aria-label="More work"
			class="border-border grid border-t sm:grid-cols-2 sm:divide-x sm:divide-[var(--border)]"
		>
			<a href="/projects" class="group py-10 sm:pr-8">
				<p class="eyebrow mb-3">Back to</p>
				<p class="flex items-center gap-3 text-2xl sm:text-3xl">
					<span class="text-muted group-hover:text-accent transition group-hover:-translate-x-1">
						&larr;
					</span>
					<span class="group-hover:text-accent transition-colors">All work</span>
				</p>
			</a>
			{
				next.id !== project.id && (
					<a
						href={`/projects/${next.id}`}
						class="group border-border border-t py-10 sm:border-t-0 sm:pl-8 sm:text-right"
					>
						<p class="eyebrow mb-3">Next project</p>
						<p class="flex items-center gap-3 text-2xl sm:justify-end sm:text-3xl">
							<span class="group-hover:text-accent transition-colors">
								{next.data.title.split(':')[0]}
							</span>
							<span class="text-muted group-hover:text-accent transition group-hover:translate-x-1">
								&rarr;
							</span>
						</p>
					</a>
				)
			}
		</nav>
	</Container>
</Entry>
