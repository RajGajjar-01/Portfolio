---
import Page from '../../layouts/Page.astro';
import Container from '../../components/ui/Container.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Page
	title="Work"
	description="Selected engineering projects: the problem, what shipped, and what it cost."
>
	<Container class="py-16 sm:py-24">
		<header class="mb-16 max-w-2xl">
			<p class="text-muted mb-3 font-mono text-xs tracking-widest uppercase">Work</p>
			<h1 class="text-4xl sm:text-6xl">Selected projects</h1>
			<p class="text-muted mt-6 text-lg leading-relaxed">
				A few things worth writing up. Each one covers the problem, the approach, and what I would
				do differently.
			</p>
		</header>

		{
			projects.length > 0 ? (
				<div class="grid gap-x-8 gap-y-16 sm:grid-cols-2">
					{projects.map((project, i) => (
						<ProjectCard project={project} eager={i < 2} />
					))}
				</div>
			) : (
				<p class="text-muted">Nothing published yet.</p>
			)
		}
	</Container>
</Page>
