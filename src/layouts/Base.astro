---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import type { SeoProps } from '../lib/seo';
import JsonLd from '../components/seo/JsonLd.astro';
import { personSchema, websiteSchema } from '../lib/schema';
import '../styles/global.css';

type Props = SeoProps;

const {
	title,
	description = site.description,
	image = '/og-default.png',
	imageAlt = `${site.name}, ${site.role}`,
	article,
	noindex,
	schema = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={site.locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		{}
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${site.name} | Writing`}
			href={new URL('rss.xml', Astro.site)}
		/>

		{}
		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:title" content={title ?? `${site.name} | ${site.role}`} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content={site.locale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title ?? `${site.name} | ${site.role}`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<meta name="twitter:creator" content={`@${site.twitter}`} />
		<meta name="author" content={site.name} />

		{
			article && (
				<>
					<meta property="article:published_time" content={article.publishedTime.toISOString()} />
					{article.modifiedTime && (
						<meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
					)}
					{article.tags?.map((tag) => (
						<meta property="article:tag" content={tag} />
					))}
				</>
			)
		}

		{}
		<JsonLd schema={personSchema()} />
		<JsonLd schema={websiteSchema()} />
		{schema.map((node) => <JsonLd schema={node} />)}

		{}
		<Font cssVariable="--font-jakarta" preload />

		{}
		<ClientRouter />
	</head>

	<body>
		<slot />

		{}
		<div class="veil" aria-hidden="true" style="view-transition-name: veil"></div>

		<script is:inline>
			if (!window.__veilBound) {
				window.__veilBound = true;
				const root = document.documentElement;

				
				
				
				
				document.addEventListener('astro:after-swap', () => {
					root.dataset.veil = '';
				});

				document.addEventListener('animationend', (event) => {
					if (event.animationName === 'veil-lift') delete root.dataset.veil;
				});
			}
		</script>

		{}
		<script is:inline>
			if (!window.__btnFillBound) {
				window.__btnFillBound = true;

				document.addEventListener('pointerover', (event) => {
					const btn = event.target.closest?.('.btn-fill');
					
					if (!btn || btn.contains(event.relatedTarget)) return;

					const rect = btn.getBoundingClientRect();
					btn.style.setProperty('--x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
					btn.style.setProperty('--y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
				});
			}
		</script>
	</body>
</html>
