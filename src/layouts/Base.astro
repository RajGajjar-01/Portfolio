---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import type { SeoProps } from '../lib/seo';
import '../styles/global.css';

type Props = SeoProps;

const { title, description = site.description, image, article, noindex } = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang={site.locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		{/* Used when the site is added to an iOS home screen. */}
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${site.name} | Writing`}
			href={new URL('rss.xml', Astro.site)}
		/>

		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={site.name} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

		{
			article && (
				<>
					<meta
						property="article:published_time"
						content={article.publishedTime.toISOString()}
					/>
					{article.modifiedTime && (
						<meta
							property="article:modified_time"
							content={article.modifiedTime.toISOString()}
						/>
					)}
					{article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
				</>
			)
		}

		{/* Self-hosted and preloaded, so text paints in the right font immediately. */}
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-serif-display" preload />

		<ClientRouter />

		{/* Runs before first paint to avoid a theme flash. */}
		<script is:inline>
			const theme = localStorage.getItem('theme');
			if (theme === 'light' || theme === 'dark') {
				document.documentElement.dataset.theme = theme;
			}

			// Astro soft navigation swaps <html> to match the incoming document,
			// which has no data-theme (it's only ever set by this script). Carry
			// the current theme forward so it survives the swap.
			document.addEventListener('astro:before-swap', (event) => {
				const current = document.documentElement.dataset.theme;
				if (current) event.newDocument.documentElement.dataset.theme = current;
			});
		</script>
	</head>

	<body>
		<slot />
	</body>
</html>
