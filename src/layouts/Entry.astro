---
import Page from './Page.astro';
import Container from '../components/ui/Container.astro';
import Tag from '../components/ui/Tag.astro';
import type { SeoProps } from '../lib/seo';
import { formatDate, isoDate } from '../lib/content';

interface Props extends SeoProps {
	heading: string;
	lede?: string;
	date?: Date;
	updatedDate?: Date;
	tags?: string[];
	
	tagHref?: (tag: string) => string;
	back: { label: string; href: string };
}

const { heading, lede, date, updatedDate, tags = [], tagHref, back, ...seo } = Astro.props;
---

<Page {...seo}>
	{}
	<div
		class="bg-accent scroll-progress fixed inset-x-0 top-0 z-50 h-0.5 origin-left"
		aria-hidden="true"
	>
	</div>

	<article class="py-16 sm:py-20">
		<Container>
			<a
				href={back.href}
				class="text-muted hover:text-fg group mb-10 inline-flex items-center gap-1.5 text-sm transition-colors"
			>
				<span class="inline-block transition-transform group-hover:-translate-x-0.5">&larr;</span>
				{back.label}
			</a>

			<header class="mb-12">
				<h1 class="max-w-3xl text-4xl leading-[1.1] sm:text-6xl">{heading}</h1>

				{lede && <p class="text-muted mt-6 max-w-2xl text-lg leading-relaxed">{lede}</p>}

				<div class="text-muted mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs">
					{date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
					{updatedDate && <span>Updated {formatDate(updatedDate)}</span>}
					<slot name="meta" />
				</div>

				{
					tags.length > 0 && (
						<div class="mt-6 flex flex-wrap gap-1.5">
							{tags.map((tag) => (
								<Tag href={tagHref?.(tag)}>{tag}</Tag>
							))}
						</div>
					)
				}
			</header>

			<slot name="hero" />

			<div class="prose">
				<slot />
			</div>
		</Container>
	</article>

	<slot name="after" />
</Page>
