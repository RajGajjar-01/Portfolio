---
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a
	href={href}
	class="relative flex place-content-center gap-[0.8em] overflow-hidden whitespace-nowrap rounded-full bg-[image:var(--gradient-accent-orange)] px-[2em] py-[0.56em] text-center leading-[1.1] text-accent-text-over no-underline shadow-md after:pointer-events-none after:absolute after:inset-0 after:mix-blend-overlay after:transition-colors after:duration-200 after:ease-in-out hover:after:bg-gray-999/30 focus:after:bg-gray-999/30 min-[20em]:text-lg lg:px-10 lg:py-[1.125rem] lg:text-xl"
>
	<slot />
</a>
