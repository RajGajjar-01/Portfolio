---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import SocialIcon from '../ui/SocialIcon.astro';
import { site, socials } from '../../data/site';
---

<Section class="border-border border-t">
	<div class="reveal">
		<h2 class="max-w-2xl text-4xl sm:text-5xl">Have something worth building?</h2>

		<p class="text-muted mt-6 max-w-lg text-lg leading-relaxed">
			I am open to AI engineering and backend roles, and to contract work on retrieval systems,
			agents, and Python APIs. The fastest way to reach me is email.
		</p>

		<div class="mt-10 flex flex-wrap items-center gap-3">
			<Button href={`mailto:${site.email}`}>{site.email}</Button>
			{
				socials
					.filter((s) => s.label !== 'Email')
					.map((s) => (
						<Button href={s.href} variant="ghost">
							{s.icon && <SocialIcon name={s.icon} class="size-4" />}
							{s.label}
						</Button>
					))
			}
		</div>
	</div>
</Section>
