---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---

<section class="relative flex min-h-[78svh] items-center overflow-hidden py-24">
	{/* Giant type mark as backdrop texture, not illustration. */}
	<span
		class="text-fg pointer-events-none absolute end-0 top-1/2 hidden -translate-y-1/2 translate-x-[8%] font-mono text-[32rem] leading-none opacity-[0.04] select-none lg:block"
		aria-hidden="true"
	>
		{'{ }'}
	</span>

	<Container>
		<p class="text-muted reveal-once mb-6 font-mono text-xs tracking-widest uppercase">
			{site.role}
		</p>

		<h1
			class="reveal-once reveal-once-delay-1 max-w-4xl pb-1 text-5xl leading-[1.15] sm:text-7xl lg:text-8xl"
		>
			I build software that <em class="text-accent italic">stays</em> fast.
		</h1>

		<p
			class="text-muted reveal-once reveal-once-delay-2 mt-8 max-w-xl text-lg leading-relaxed text-balance"
		>
			{site.description}
		</p>

		<div class="reveal-once reveal-once-delay-3 mt-10 flex flex-wrap gap-3">
			<Button href="/projects">View work</Button>
			<Button href={`mailto:${site.email}`} variant="outline">Get in touch</Button>
		</div>
	</Container>
</section>
