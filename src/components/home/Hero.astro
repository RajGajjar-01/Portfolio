---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---

<section class="relative flex min-h-[78svh] items-center overflow-hidden py-24">
	{/* Giant type mark as backdrop texture, not illustration. */}
	<span
		class="text-fg pointer-events-none absolute end-0 top-1/2 hidden translate-x-[8%] -translate-y-1/2 font-mono text-[32rem] leading-none opacity-[0.04] select-none lg:block"
		aria-hidden="true"
	>
		{'{ }'}
	</span>

	<Container>
		<p class="text-muted reveal-once mb-6 font-mono text-xs tracking-widest uppercase">
			{site.role}
		</p>

		<h1
			class="reveal-once reveal-once-delay-1 max-w-4xl pb-1 text-4xl leading-[1.15] font-light sm:text-5xl lg:text-6xl"
		>
			I build <em class="text-accent italic">AI systems</em> that hold up in production.
		</h1>

		<p
			class="text-muted reveal-once reveal-once-delay-2 mt-8 max-w-xl text-lg leading-relaxed text-balance"
		>
			I am {site.name}, an {site.role.toLowerCase()} in {site.location.city}, India. I work on
			retrieval, agents, and the API layer underneath them, mostly in Python and FastAPI.
		</p>

		<div class="reveal-once reveal-once-delay-3 mt-10 flex flex-wrap gap-3">
			<Button href="/projects">View work</Button>
			<Button href={`mailto:${site.email}`} variant="outline">Get in touch</Button>
		</div>
	</Container>
</section>
