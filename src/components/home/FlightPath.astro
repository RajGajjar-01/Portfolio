---

const W = 1440;
const H = 9400;

// Static start of the route. FlightPath's script appends the rest once it knows where the
// footer wordmark is, because the route has to end on it at any page height.
const motion = [
	'M209.5 490.5',
	'C-41.4 613.3 43.3 876.4 73.8 934.7',
	'C104.4 993.0 186.1 1044.8 261.8 1049.5',
	'C337.4 1054.2 855.4 1071.0 1199.9 1244.3',
	'C1544.4 1417.5 1479.6 2043.7 1241.0 2046.7',
	'C1002.4 2049.7 453.6 1835.8 203.8 2010.3',
	'C-45.9 2184.9 14.1 2481.7 209.3 2564.2',
	'C404.5 2646.6 859.8 2617.2 1040.0 2641.2',
	'C1220.2 2665.2 1356.9 2783.1 1336.1 3012.5',
].join('');

const trail = [
	'M209.5 490.5',
	'C-41.4 613.3 43.3 876.4 73.8 934.7',
	'C104.4 993.0 186.1 1044.8 261.8 1049.5',
	'M1199.9 1244.3',
	'C1544.4 1417.5 1479.6 2043.7 1241.0 2046.7',
	'M203.8 2010.3',
	'C-45.9 2184.9 14.1 2481.7 209.3 2564.2',
	'C404.5 2646.6 859.8 2617.2 1040.0 2641.2',
	'C1220.2 2665.2 1356.9 2783.1 1336.1 3012.5',
].join('');
---

<div
	class="flight"
	aria-hidden="true"
	style={`--flight-d: path('${motion}'); width: ${W}px; height: ${H}px`}
>
	<svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} fill="none">
		{
			
		}
		<mask id="flight-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
			<path class="flight-draw" d={motion} pathLength="1" stroke="#fff" stroke-width="24"></path>
		</mask>

		<path
			d={trail}
			mask="url(#flight-reveal)"
			stroke="var(--muted)"
			stroke-width="1.4"
			stroke-dasharray="10 6"></path>
	</svg>

	{
		
	}
	<img class="flight-plane" src="/plane.svg" width="64" height="64" alt="" />
</div>

<script>
	const START_Y = 490.5;
	// Where the static head of the route ends, and where the dive into the wordmark ends
	// (both in the 1440px-wide design space before the route is stretched to the page).
	const HEAD_END = { x: 1336.1, y: 3012.5 };
	const DESIGN_END_Y = 9300;
	// Alternating sides, so the plane sweeps across the whole page and not one gutter.
	const SWINGS: [number, number][] = [
		[170, 3800],
		[1280, 4700],
		[150, 5600],
		[1290, 6500],
		[170, 7400],
		[1310, 8250],
	];

	const STEPS = 1500;
	const f = (n: number) => n.toFixed(1);

	// Leaves and arrives heading straight down, so consecutive swings join smoothly.
	const swing = (x0: number, y0: number, x1: number, y1: number) => {
		const m = (y1 - y0) / 2;
		return `C${f(x0)} ${f(y0 + m)} ${f(x1)} ${f(y1 - m)} ${f(x1)} ${f(y1)}`;
	};

	// Everything after the static head: the swings, then a curl into the end of the word.
	const rest = (endX: number) => {
		const segs: string[] = [];
		let [x, y] = [HEAD_END.x, HEAD_END.y];
		for (const [nx, ny] of SWINGS) {
			segs.push(swing(x, y, nx, ny));
			[x, y] = [nx, ny];
		}
		segs.push(
			`C${f(x)} ${f(y + 550)} ${f(endX + 170)} ${f(DESIGN_END_Y - 90)} ${f(endX)} ${f(DESIGN_END_Y)}`,
		);
		return segs.join('');
	};

	// Every number in the path data alternates x, y; stretch only the y values.
	const stretch = (d: string, k: number) => {
		let i = 0;
		return d.replace(/-?\d+(?:\.\d+)?/g, (n) =>
			i++ % 2 ? (START_Y + (Number(n) - START_Y) * k).toFixed(1) : n,
		);
	};

	let cleanup: AbortController | null = null;

	const init = () => {
		cleanup?.abort();
		cleanup = new AbortController();
		const { signal } = cleanup;
		const root = document.documentElement;
		root.removeAttribute('data-flight-landed');

		const flight = document.querySelector<HTMLElement>('.flight');
		const svg = flight?.querySelector<SVGSVGElement>('svg');
		const geometry = flight?.querySelector<SVGGeometryElement>('.flight-draw');
		const trailPath = flight?.querySelector<SVGPathElement>('path[mask]');
		const mask = flight?.querySelector<SVGMaskElement>('mask');
		const letters = document.querySelectorAll<HTMLElement>('.wordmark-rise > span');
		if (!flight || !svg || !geometry || !trailPath || !mask) return;
		if (getComputedStyle(flight).display === 'none') return;

		const baseMotion = geometry.getAttribute('d') ?? '';
		const baseTrail = trailPath.getAttribute('d') ?? '';

		let ys: number[] = [];
		let top = 0;
		let routeEnd = 0;

		// Build the route so it ends on the right end of the footer wordmark, and stretch it
		// so the plane gets there exactly when the wordmark reaches the middle of the screen.
		const layout = () => {
			// Collapse first so the route itself never counts towards the page height.
			flight.style.height = '0px';
			const box = flight.getBoundingClientRect();
			top = box.top + window.scrollY;
			const doc = document.documentElement.scrollHeight;

			// The letters rise into place on scroll, so measure the untransformed layout box:
			// the wordmark line for the height and the last letter's offset for the x.
			const last = letters[letters.length - 1];
			const line = last?.parentElement?.getBoundingClientRect();
			const endX = last && line
				? line.left + last.offsetLeft - last.parentElement!.offsetLeft + last.offsetWidth * 0.5 - box.left
				: 1200;
			routeEnd = line ? line.top + window.scrollY + line.height * 0.5 - top : doc - top - 200;

			const k = Math.max(0.5, (routeEnd - START_Y) / (DESIGN_END_Y - START_Y));
			const tail = rest(endX);
			const motion = stretch(baseMotion + tail, k);
			// Stop just past the landing point so the route never makes the page longer.
			const height = Math.ceil(Math.min(doc - top, routeEnd + 150));

			geometry.setAttribute('d', motion);
			trailPath.setAttribute('d', stretch(baseTrail + tail, k));
			flight.style.setProperty('--flight-d', `path('${motion}')`);
			flight.style.height = `${height}px`;
			svg.setAttribute('height', String(height));
			svg.setAttribute('viewBox', `0 0 ${svg.getAttribute('width')} ${height}`);
			mask.setAttribute('height', String(height));

			const total = geometry.getTotalLength();
			ys = [];
			for (let i = 0; i <= STEPS; i++) {
				const y = geometry.getPointAtLength((i / STEPS) * total).y;
				ys.push(i === 0 ? y : Math.max(y, ys[i - 1]));
			}
		};

		// Progress along the route at which the plane sits at the given path y,
		// so it stays in the middle of the viewport while scrolling down.
		const progressAt = (y: number) => {
			if (y <= ys[0]) return 0;
			let lo = 0;
			let hi = STEPS;
			while (lo < hi) {
				const mid = (lo + hi) >> 1;
				if (ys[mid] >= y) hi = mid;
				else lo = mid + 1;
			}
			return lo / STEPS;
		};

		let current = 0;
		let frame = 0;
		let landed = false;
		let lastFp = '';
		const tick = () => {
			frame = 0;
			// The plane rides the middle of the screen. If the page cannot scroll far enough
			// for the wordmark to reach the middle, it catches up over the last screenful so
			// it still lands on the wordmark at the bottom of the page.
			const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
			const short = Math.max(0, top + routeEnd - window.innerHeight / 2 - maxScroll);
			const catchUp = Math.min(1, Math.max(0, 1 - (maxScroll - window.scrollY) / window.innerHeight));
			const y = window.scrollY + window.innerHeight / 2 - top + short * catchUp;
			const target = progressAt(y);
			// Scrolling is already smoothed by Lenis; only ease the jumps where the route
			// doubles back on itself, so the plane does not trail behind the page.
			current += (target - current) * 0.45;
			if (Math.abs(target - current) < 0.0004) current = target;

			// On arrival the plane pops and the wordmark fills with the accent colour.
			const arrived = current >= 0.995 && y >= routeEnd - 3;
			if (arrived !== landed) {
				landed = arrived;
				flight.toggleAttribute('data-landed', landed);
				root.toggleAttribute('data-flight-landed', landed);
			}

			// Skip repaints of the (very tall) trail when nothing visibly moved.
			const fp = current.toFixed(4);
			if (fp !== lastFp) {
				lastFp = fp;
				flight.style.setProperty('--fp', fp);
				flight.style.setProperty('--fo', Math.min(1, current / 0.01).toFixed(3));
			}
			if (current !== target) frame = requestAnimationFrame(tick);
		};
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(tick);
		};

		layout();
		tick();
		window.addEventListener('scroll', schedule, { passive: true, signal });

		// Late layout shifts (fonts, images, sticky sections) change the page height.
		const relayout = () => {
			layout();
			schedule();
		};
		const observer = new ResizeObserver(relayout);
		observer.observe(document.body);
		document.fonts?.ready.then(relayout);
		signal.addEventListener('abort', () => {
			observer.disconnect();
			cancelAnimationFrame(frame);
		});
	};

	// Runs on first load and after every client-side navigation back to the home page.
	document.addEventListener('astro:page-load', init);
	document.addEventListener('astro:before-swap', () => cleanup?.abort());
</script>
