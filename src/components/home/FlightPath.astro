---

const W = 1440;
const H = 9400;

// The "How I work" section is about 6,300px tall with its text on the left, so the
// route weaves through the empty right-hand side in long S-curves instead of
// crossing the copy. Each half-wave leaves and arrives heading straight down.
const WAVE_START = { x: 1336.1, y: 3012.5 };
const WAVE_END_Y = 9300;
const WAVE_X = [1010, 1330, 1040, 1300, 990, 1340, 1030, 1310, 1000, 1330, 1050, 1320];
const wave = (() => {
	const step = (WAVE_END_Y - WAVE_START.y) / WAVE_X.length;
	let { x, y } = WAVE_START;
	return WAVE_X.map((nx) => {
		const ny = y + step;
		const seg = `C${x.toFixed(1)} ${(y + step * 0.5).toFixed(1)} ${nx.toFixed(1)} ${(ny - step * 0.5).toFixed(1)} ${nx.toFixed(1)} ${ny.toFixed(1)}`;
		x = nx;
		y = ny;
		return seg;
	});
})();

const motion = [
	'M209.5 490.5',
	'C-41.4 613.3 43.3 876.4 73.8 934.7',
	'C104.4 993.0 186.1 1044.8 261.8 1049.5',
	'C337.4 1054.2 855.4 1071.0 1199.9 1244.3',
	'C1544.4 1417.5 1479.6 2043.7 1241.0 2046.7',
	'C1002.4 2049.7 453.6 1835.8 203.8 2010.3',
	'C-45.9 2184.9 14.1 2481.7 209.3 2564.2',
	'C404.5 2646.6 859.8 2617.2 1040.0 2641.2',
	'C1220.2 2665.2 1356.9 2783.1 1336.1 3012.5',
	...wave,
].join('');

const trail = [
	'M209.5 490.5',
	'C-41.4 613.3 43.3 876.4 73.8 934.7',
	'C104.4 993.0 186.1 1044.8 261.8 1049.5',
	'M1199.9 1244.3',
	'C1544.4 1417.5 1479.6 2043.7 1241.0 2046.7',
	'M203.8 2010.3',
	'C-45.9 2184.9 14.1 2481.7 209.3 2564.2',
	'C404.5 2646.6 859.8 2617.2 1040.0 2641.2',
	'C1220.2 2665.2 1356.9 2783.1 1336.1 3012.5',
	...wave,
].join('');
---

<div
	class="flight"
	aria-hidden="true"
	style={`--flight-d: path('${motion}'); width: ${W}px; height: ${H}px`}
>
	<svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} fill="none">
		{
			
		}
		<mask id="flight-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
			<path class="flight-draw" d={motion} pathLength="1" stroke="#fff" stroke-width="24"></path>
		</mask>

		<path
			d={trail}
			mask="url(#flight-reveal)"
			stroke="var(--muted)"
			stroke-width="1.4"
			stroke-dasharray="10 6"></path>
	</svg>

	{
		
	}
	<img class="flight-plane" src="/plane.svg" width="64" height="64" alt="" />
</div>

<script>
	const flight = document.querySelector<HTMLElement>('.flight');
	const svg = flight?.querySelector<SVGSVGElement>('svg');
	const geometry = flight?.querySelector<SVGGeometryElement>('.flight-draw');
	const trailPath = flight?.querySelector<SVGPathElement>('path[mask]');
	const maskRect = flight?.querySelector<SVGMaskElement>('mask');

	if (flight && svg && geometry && trailPath && maskRect && getComputedStyle(flight).display !== 'none') {
		const STEPS = 1500;
		const START_Y = 490.5;
		const baseMotion = geometry.getAttribute('d') ?? '';
		const baseTrail = trailPath.getAttribute('d') ?? '';
		const baseEnd = Number(baseMotion.trim().split(/[\s,]+/).slice(-1)[0]);

		// Every number in the path data alternates x, y; stretch only the y values.
		const stretch = (d: string, k: number) => {
			let i = 0;
			return d.replace(/-?\d+(?:\.\d+)?/g, (n) =>
				i++ % 2 ? (START_Y + (Number(n) - START_Y) * k).toFixed(1) : n,
			);
		};

		let ys: number[] = [];
		let top = 0;

		// The route ends at the line above the contact section (or the page bottom if
		// there is none) and the plane fades out just before it gets there.
		const FADE = 260;
		let routeEnd = 0;

		// Stretch the route so the plane reaches its end exactly when the viewport
		// middle reaches that line, so it is always in the middle of the screen.
		const layout = () => {
			// Collapse first so the route itself never counts towards the page height.
			flight.style.height = '0px';
			top = flight.getBoundingClientRect().top + window.scrollY;
			const doc = document.documentElement.scrollHeight;
			const contact = document.getElementById('contact');
			const line = contact ? contact.getBoundingClientRect().top + window.scrollY : doc;
			routeEnd = Math.min(line - top - 24, doc - window.innerHeight / 2 - top);
			const k = Math.max(0.5, (routeEnd - START_Y) / (baseEnd - START_Y));
			const motion = stretch(baseMotion, k);
			const height = Math.ceil(doc - top);

			geometry.setAttribute('d', motion);
			trailPath.setAttribute('d', stretch(baseTrail, k));
			flight.style.setProperty('--flight-d', `path('${motion}')`);
			flight.style.height = `${height}px`;
			svg.setAttribute('height', String(height));
			svg.setAttribute('viewBox', `0 0 ${svg.getAttribute('width')} ${height}`);
			maskRect.setAttribute('height', String(height));

			const total = geometry.getTotalLength();
			ys = [];
			for (let i = 0; i <= STEPS; i++) {
				const y = geometry.getPointAtLength((i / STEPS) * total).y;
				ys.push(i === 0 ? y : Math.max(y, ys[i - 1]));
			}
		};

		// Progress along the route at which the plane sits at the given path y,
		// so it stays in the middle of the viewport while scrolling down.
		const progressAt = (y: number) => {
			if (y <= ys[0]) return 0;
			let lo = 0;
			let hi = STEPS;
			while (lo < hi) {
				const mid = (lo + hi) >> 1;
				if (ys[mid] >= y) hi = mid;
				else lo = mid + 1;
			}
			return lo / STEPS;
		};

		let current = 0;
		let frame = 0;
		const tick = () => {
			frame = 0;
			const y = window.scrollY + window.innerHeight / 2 - top;
			const target = progressAt(y);
			const fade = Math.min(1, Math.max(0, (routeEnd - y) / FADE));
			current += (target - current) * 0.14;
			if (Math.abs(target - current) < 0.0004) current = target;
			flight.style.setProperty('--fp', current.toFixed(5));
			flight.style.setProperty('--fo', (Math.min(1, current / 0.01) * fade).toFixed(3));
			if (current !== target) frame = requestAnimationFrame(tick);
		};
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(tick);
		};

		layout();
		tick();
		window.addEventListener('scroll', schedule, { passive: true });
		// Late layout shifts (fonts, images, sticky sections) change the page height.
		window.addEventListener('load', () => {
			layout();
			schedule();
		});
		new ResizeObserver(() => {
			layout();
			schedule();
		}).observe(document.body);
	}
</script>
