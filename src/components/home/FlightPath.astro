---

const W = 1440;
const H = 9400;

// Static start of the route. FlightPath's script appends the rest once it knows where the
// footer wordmark is, because the route has to end on it at any page height.
const motion = [
	'M209.5 490.5',
	'C-41.4 613.3 43.3 876.4 73.8 934.7',
	'C104.4 993.0 186.1 1044.8 261.8 1049.5',
	'C337.4 1054.2 855.4 1071.0 1199.9 1244.3',
	'C1544.4 1417.5 1479.6 2043.7 1241.0 2046.7',
	'C1002.4 2049.7 453.6 1835.8 203.8 2010.3',
	'C-45.9 2184.9 14.1 2481.7 209.3 2564.2',
	'C404.5 2646.6 859.8 2617.2 1040.0 2641.2',
	'C1220.2 2665.2 1356.9 2783.1 1336.1 3012.5',
].join('');

const trail = [
	'M209.5 490.5',
	'C-41.4 613.3 43.3 876.4 73.8 934.7',
	'C104.4 993.0 186.1 1044.8 261.8 1049.5',
	'M1199.9 1244.3',
	'C1544.4 1417.5 1479.6 2043.7 1241.0 2046.7',
	'M203.8 2010.3',
	'C-45.9 2184.9 14.1 2481.7 209.3 2564.2',
	'C404.5 2646.6 859.8 2617.2 1040.0 2641.2',
	'C1220.2 2665.2 1356.9 2783.1 1336.1 3012.5',
].join('');
---

<div
	class="flight"
	aria-hidden="true"
	style={`--flight-d: path('${motion}'); width: ${W}px; height: ${H}px`}
>
	<svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} fill="none">
		{
			
		}
		<mask id="flight-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
			<path class="flight-draw" d={motion} pathLength="1" stroke="#fff" stroke-width="24"></path>
		</mask>

		<path
			d={trail}
			mask="url(#flight-reveal)"
			stroke="var(--muted)"
			stroke-width="1.4"
			stroke-dasharray="10 6"></path>
	</svg>

	{
		
	}
	<img class="flight-plane" src="/plane.svg" width="64" height="64" alt="" />
</div>

<script>
	const START_Y = 490.5;
	// Where the static head of the route ends, and the y the head is stretched against
	// (both in the 1440px-wide design space).
	const HEAD_END = { x: 1336.1, y: 3012.5 };
	const DESIGN_END_Y = 9300;
	// After the head the route is built in page pixels: tight swings between the gutters,
	// then a loop before the plane dives into the line above Contact.
	const PITCH = 800;
	const LOOP = 1300;
	// Each swing differs, so the trail never settles into one repeated curve: where it turns
	// (odd entries on the left, even on the right), its relative height, how round it is
	// (handle length as a share of the drop) and a lean on the heading through the turn.
	// Cycled in order, never random, so the route is the same on every visit.
	const SWINGS = [
		{ x: 170, h: 1, round: 0.5, lean: 0.1 },
		{ x: 1220, h: 0.75, round: 0.62, lean: -0.15 },
		{ x: 380, h: 1.25, round: 0.42, lean: 0.15 },
		{ x: 1310, h: 0.85, round: 0.56, lean: 0 },
		{ x: 250, h: 0.7, round: 0.66, lean: -0.1 },
		{ x: 1100, h: 1.15, round: 0.46, lean: 0.12 },
	];
	// The route ends this far below the line above Contact. The flight is clipped at that
	// line, so the plane dives into it and vanishes, trail and all.
	const DIVE = 80;

	const STEPS = 1500;
	const f = (n: number) => n.toFixed(1);

	type Pt = [number, number];
	// One cubic from p (heading d) to q (heading e); both directions are unit vectors.
	const seg = (p: Pt, d: Pt, q: Pt, e: Pt, t = 0.5) => {
		const len = Math.hypot(q[0] - p[0], q[1] - p[1]) * t;
		return `C${f(p[0] + d[0] * len)} ${f(p[1] + d[1] * len)} ${f(q[0] - e[0] * len)} ${f(q[1] - e[1] * len)} ${f(q[0])} ${f(q[1])}`;
	};
	const DOWN: Pt = [0, 1];
	const LEFTWARD: Pt = [-1, 0];
	const RIGHTWARD: Pt = [1, 0];
	const DOWN_RIGHT: Pt = [0.6, 0.8];

	// Everything after the head, from (x, y0) down to the bottom of the route at `end`.
	const rest = (y0: number, end: number) => {
		const segs: string[] = [];
		const loopTop = Math.max(y0, end - LOOP);
		// An even number of swings, so the last one arrives on the right, where the loop starts.
		const n = 2 * Math.round((loopTop - y0) / (2 * PITCH));
		const picks = Array.from({ length: n }, (_, i) => SWINGS[i % SWINGS.length]);
		const total = picks.reduce((sum, w) => sum + w.h, 0);
		let p: Pt = [HEAD_END.x, y0];
		let dir: Pt = DOWN;
		let y = y0;
		for (const w of picks) {
			y += ((loopTop - y0) * w.h) / total;
			const q: Pt = [w.x, y];
			const next: Pt = [w.lean / Math.hypot(w.lean, 1), 1 / Math.hypot(w.lean, 1)];
			// Handles scale with the drop, not the (mostly sideways) chord, so every crossing
			// is a smooth arc: never a straight dive, never a boxy turn.
			const chord = Math.hypot(q[0] - p[0], q[1] - p[1]);
			segs.push(seg(p, dir, q, next, (w.round * (q[1] - p[1])) / chord));
			[p, dir] = [q, next];
		}
		// Sweep left across the page, curl down the left side, skim along just above the
		// line and dip into it.
		const h = end - loopTop;
		const at = (x: number, y: number): Pt => [x, loopTop + h * y];
		const a = at(700, 0.24);
		const b = at(230, 0.58);
		const c = at(760, 0.9);
		const e = at(1330, 1);
		segs.push(
			seg(p, dir, a, LEFTWARD),
			seg(a, LEFTWARD, b, DOWN),
			seg(b, DOWN, c, RIGHTWARD),
			seg(c, RIGHTWARD, e, DOWN_RIGHT),
		);
		return segs.join('');
	};

	// The route's y at STEPS + 1 evenly spaced distances along it, never decreasing (where the
	// route climbs, y holds). Done in one pass over a flattened copy of the path: the
	// browser's getPointAtLength() re-walks the path from the start on every call, which
	// cost seconds per layout on this route and froze the intro.
	const sampleYs = (d: string) => {
		const t = d.match(/[MC]|-?\d+(?:\.\d+)?/g) ?? [];
		const pts: Pt[] = [];
		let p: Pt = [0, 0];
		for (let i = 0; i < t.length; ) {
			if (t[i++] === 'M') {
				p = [+t[i++], +t[i++]];
				pts.push(p);
				continue;
			}
			const [x1, y1, x2, y2, x, y] = t.slice(i, (i += 6)).map(Number);
			for (let k = 1; k <= 24; k++) {
				const u = k / 24;
				const v = 1 - u;
				pts.push([
					v * v * v * p[0] + 3 * v * v * u * x1 + 3 * v * u * u * x2 + u * u * u * x,
					v * v * v * p[1] + 3 * v * v * u * y1 + 3 * v * u * u * y2 + u * u * u * y,
				]);
			}
			p = [x, y];
		}
		const at = [0];
		for (let k = 1; k < pts.length; k++) {
			at.push(at[k - 1] + Math.hypot(pts[k][0] - pts[k - 1][0], pts[k][1] - pts[k - 1][1]));
		}
		const total = at[at.length - 1];
		const out: number[] = [];
		let k = 1;
		for (let i = 0; i <= STEPS; i++) {
			const want = (i / STEPS) * total;
			while (k < pts.length - 1 && at[k] < want) k++;
			const span = at[k] - at[k - 1] || 1;
			const y = pts[k - 1][1] + ((pts[k][1] - pts[k - 1][1]) * (want - at[k - 1])) / span;
			out.push(i === 0 ? pts[0][1] : Math.max(y, out[i - 1]));
		}
		return out;
	};

	// Every number in the path data alternates x, y; stretch only the y values.
	const stretch = (d: string, k: number) => {
		let i = 0;
		return d.replace(/-?\d+(?:\.\d+)?/g, (n) =>
			i++ % 2 ? (START_Y + (Number(n) - START_Y) * k).toFixed(1) : n,
		);
	};

	let cleanup: AbortController | null = null;

	const init = () => {
		cleanup?.abort();
		cleanup = new AbortController();
		const { signal } = cleanup;

		const flight = document.querySelector<HTMLElement>('.flight');
		const svg = flight?.querySelector<SVGSVGElement>('svg');
		const geometry = flight?.querySelector<SVGGeometryElement>('.flight-draw');
		const trailPath = flight?.querySelector<SVGPathElement>('path[mask]');
		const mask = flight?.querySelector<SVGMaskElement>('mask');
		const wordmark = document.querySelector<HTMLElement>('.wordmark-rise');
		const contact = document.querySelector<HTMLElement>('.flight-end');
		if (!flight || !svg || !geometry || !trailPath || !mask) return;
		if (getComputedStyle(flight).display === 'none') return;

		const baseMotion = geometry.getAttribute('d') ?? '';
		const baseTrail = trailPath.getAttribute('d') ?? '';

		let ys: number[] = [];
		let top = 0;
		let routeEnd = 0;

		// Stretch the head to the page the way it was designed (against the footer wordmark),
		// then run the swings and the loop across the top of Contact, where the plane
		// arrives as that point reaches the middle of the screen.
		const layout = () => {
			// Collapse first so the route itself never counts towards the page height.
			flight.style.height = '0px';
			const box = flight.getBoundingClientRect();
			top = box.top + window.scrollY;
			const doc = document.documentElement.scrollHeight;

			const word = wordmark?.getBoundingClientRect();
			const wordY = word ? word.top + window.scrollY + word.height * 0.5 - top : doc - top - 200;
			const k = Math.max(0.5, (wordY - START_Y) / (DESIGN_END_Y - START_Y));
			const headEnd = START_Y + (HEAD_END.y - START_Y) * k;

			const line = contact?.getBoundingClientRect();
			const lineY = line ? line.top + window.scrollY - top : wordY;
			routeEnd = Math.max(lineY + DIVE, headEnd + 300);

			const tail = rest(headEnd, routeEnd);
			const motion = stretch(baseMotion, k) + tail;
			// End the layer on the line: the plane passes behind it (overflow is clipped).
			const height = Math.ceil(Math.min(doc - top, routeEnd - DIVE));

			geometry.setAttribute('d', motion);
			trailPath.setAttribute('d', stretch(baseTrail, k) + tail);
			flight.style.setProperty('--flight-d', `path('${motion}')`);
			flight.style.height = `${height}px`;
			svg.setAttribute('height', String(height));
			svg.setAttribute('viewBox', `0 0 ${svg.getAttribute('width')} ${height}`);
			mask.setAttribute('height', String(height));

			ys = sampleYs(motion);
		};

		// Progress along the route at which the plane sits at the given path y,
		// so it stays in the middle of the viewport while scrolling down.
		const progressAt = (y: number) => {
			if (y <= ys[0]) return 0;
			let lo = 0;
			let hi = STEPS;
			while (lo < hi) {
				const mid = (lo + hi) >> 1;
				if (ys[mid] >= y) hi = mid;
				else lo = mid + 1;
			}
			return lo / STEPS;
		};

		let current = 0;
		let frame = 0;
		let lastFp = '';
		const tick = () => {
			frame = 0;
			// The plane rides the middle of the screen until the line above Contact is half a
			// screen below the fold. From there it pulls ahead, down to the bottom of the
			// screen, so it meets the line as the line scrolls in and flies into it.
			const vh = window.innerHeight;
			const below = top + routeEnd - DIVE - (window.scrollY + vh);
			const ahead = (vh / 2) * Math.min(1, Math.max(0, 1 - below / (vh / 2)));
			const y = window.scrollY + vh / 2 - top + ahead;
			const target = progressAt(y);
			// Scrolling is already smoothed by Lenis; only ease the jumps where the route
			// doubles back on itself, so the plane does not trail behind the page.
			current += (target - current) * 0.45;
			if (Math.abs(target - current) < 0.0004) current = target;

			// Skip repaints of the (very tall) trail when nothing visibly moved.
			const fp = current.toFixed(4);
			if (fp !== lastFp) {
				lastFp = fp;
				flight.style.setProperty('--fp', fp);
				flight.style.setProperty('--fo', Math.min(1, current / 0.01).toFixed(3));
			}
			if (current !== target) frame = requestAnimationFrame(tick);
		};
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(tick);
		};

		layout();
		tick();
		window.addEventListener('scroll', schedule, { passive: true, signal });

		// Late layout shifts (fonts, images, sticky sections) change the page height.
		const relayout = () => {
			layout();
			schedule();
		};
		const observer = new ResizeObserver(relayout);
		observer.observe(document.body);
		document.fonts?.ready.then(relayout);
		signal.addEventListener('abort', () => {
			observer.disconnect();
			cancelAnimationFrame(frame);
		});
	};

	// Runs on first load and after every client-side navigation back to the home page.
	document.addEventListener('astro:page-load', init);
	document.addEventListener('astro:before-swap', () => cleanup?.abort());
</script>
