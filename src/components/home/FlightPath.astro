---
/**
 * Decorative paper plane that rides a dashed trail down the home page as you
 * scroll. Zero JS: the trail is revealed by an SVG mask and the plane by
 * `offset-distance`, both driven by a scroll timeline in motion.css.
 *
 * The overlay is a fixed 1:1 pixel box on purpose — one SVG user unit is one
 * CSS px — so the same geometry can drive the mask stroke and the plane's CSS
 * `offset-path` without the two drifting apart at any viewport width. It is
 * centred and clipped rather than scaled.
 */
const W = 1440;
const H = 5900;

/* Scroll positions, in px, that bracket the flight.
 *
 * START: nothing is drawn until the hero has been read; the plane fades in at
 * the head of the path rather than sitting parked there waiting to be scrolled
 * to (the opacity ramp in flight-fly does that).
 *
 * END: the plane lands on the rule above the footer (Contact's top border,
 * document y 5796 at the time of writing — the path's last point is placed
 * to match).
 *
 * ponytail: both are hand-measured against the current home page rather than
 * derived. One CSS animation gets one timeline, so anchoring the start to the
 * hero and the end to a rule 6000px later cannot be expressed with view()
 * ranges. If the page grows, remeasure the rule and move END and the path's
 * final y together.
 */
const START = 350;
const END = 5380;

/* The plane's route: one continuous curve, never painted. */
const motion = [
	'M209.5 490.5',
	'C109.5 640.7 69.5 849.2 87.5 990.9',
	'C102.5 1121.0 191.5 1187.8 254.5 1232.9',
	'C618.7 1493.3 840.4 1418.0 1217 1623.5',
	'C1389.6 1717.7 1397.8 2155.3 1170 2304.1',
	'C931.4 2459.9 785.7 2315.6 529.6 2330.3',
	'C349.3 2340.6 -0.3 2599.2 124.1 3247.9',
	'C190.4 3459.9 433 3733.4 685.7 3452.6',
	'C1044.4 3054.0 1392 3126.4 1392 3672.7',
	'C1392 4226.5 1083.5 4317.6 825.1 4184.3',
	'C566.8 4051.0 286.3 4007.8 211.8 4481.9',
	'C132.7 4985.2 555.6 5226.1 799.1 4965.5',
	'C1042.6 4705.1 1382.7 5197.1 1150 5658.5',
].join('');

/* Same route with two stretches lifted out, so the trail is not drawn where it
   would cut across the copy — the plane glides those gaps unaccompanied. */
const trail = [
	'M209.5 490.5',
	'C109.5 640.7 69.5 849.2 87.5 990.9',
	'C102.5 1121.0 191.5 1187.8 254.5 1232.9',
	'M1217 1623.5',
	'C1389.6 1717.7 1397.8 2155.3 1170 2304.1',
	'M529.6 2330.3',
	'C349.3 2340.6 -0.3 2599.2 124.1 3247.9',
	'C190.4 3459.9 433 3733.4 685.7 3452.6',
	'C1044.4 3054.0 1392 3126.4 1392 3672.7',
	'C1392 4226.5 1083.5 4317.6 825.1 4184.3',
	'C566.8 4051.0 286.3 4007.8 211.8 4481.9',
	'C132.7 4985.2 555.6 5226.1 799.1 4965.5',
	'C1042.6 4705.1 1382.7 5197.1 1150 5658.5',
].join('');
---

<div
	class="flight"
	aria-hidden="true"
	style={`--flight-d: path('${motion}'); --flight-start: ${START}px; --flight-end: ${END}px; width: ${W}px; height: ${H}px`}
>
	<svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} fill="none">
		{
			/* Wipes along the continuous route, so the dashes appear as the plane
		    passes and the gaps stay empty. pathLength=1 makes the dash offset a
		    plain 1 → 0 progress value. */
		}
		<mask id="flight-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
			<path class="flight-draw" d={motion} pathLength="1" stroke="#fff" stroke-width="24"></path>
		</mask>

		<path
			d={trail}
			mask="url(#flight-reveal)"
			stroke="var(--muted)"
			stroke-width="1.4"
			stroke-dasharray="10 6"></path>
	</svg>

	{
		/* The sprite is drawn nose down-right, so offset-rotate in motion.css
	    takes that 33deg back out before aligning it with the path. */
	}
	<img class="flight-plane" src="/plane.svg" width="46" height="46" alt="" />
</div>
