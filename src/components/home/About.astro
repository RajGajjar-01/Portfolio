---
import Section from '../ui/Section.astro';

const paragraphs = [
	'I am an AI engineer at E2M Solutions in Ahmedabad, where I take AI features for digital agency clients from architecture through production. Most of that work is retrieval, tool-calling agents, and the FastAPI services holding them together.',
	'Before this I built AutoLead, a RAG assistant on LangChain and LangGraph that books calls, test drives, and service appointments from plain language, running semantic search over pgvector. More recently, a rich-text editor with automated document generation, e-signatures, and audit logging that cut turnaround on a core client workflow by about 60%.',
];

// One sweep across all paragraphs: each takes a slice of the shared
// timeline sized by its length, so the next starts where the last ends.
const total = paragraphs.reduce((n, text) => n + text.length, 0);
let done = 0;
const slices = paragraphs.map((text) => {
	const from = done / total;
	done += text.length;
	return { text, from, to: done / total };
});
---

<Section id="about">
	<div
		class="reveal-text mx-auto max-w-4xl space-y-8 text-center text-2xl leading-relaxed text-balance sm:text-3xl sm:leading-relaxed"
	>
		{
			slices.map(({ text, from, to }) => (
				<p>
					<span style={`--from:${from};--to:${to}`}>{text}</span>
				</p>
			))
		}
	</div>
</Section>
