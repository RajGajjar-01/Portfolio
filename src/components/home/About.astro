---
import Section from '../ui/Section.astro';

const paragraphs = [
	"I'm an AI engineer in Ahmedabad, and I'm most curious about software that acts on its own: agents that plan before they touch anything, voice assistants you can actually hold a conversation with, and tools that turn plain language into real work. Outside of that, I like digging into how the things we take for granted work under the hood, like TLS, and building interfaces with a bit of motion in them, like the plane you've been following down this page.",
];

// One sweep across all paragraphs: each takes a slice of the shared
// timeline sized by its length, so the next starts where the last ends.
const total = paragraphs.reduce((n, text) => n + text.length, 0);
let done = 0;
const slices = paragraphs.map((text) => {
	const from = done / total;
	done += text.length;
	return { text, from, to: done / total };
});
---

<Section id="about">
	<div
		class="reveal-text mx-auto max-w-4xl space-y-8 text-center text-2xl leading-relaxed text-balance sm:text-3xl sm:leading-relaxed"
	>
		{
			slices.map(({ text, from, to }) => (
				<p>
					<span style={`--from:${from};--to:${to}`}>{text}</span>
				</p>
			))
		}
	</div>
</Section>
