---
import Section from '../ui/Section.astro';

const steps = [
	{
		title: 'First I learn what a right answer looks like to you.',
		body: 'Not the roadmap, the actual work: your data, your edge cases, the questions your users type at 2am. AI projects fail on that definition far more often than they fail on the model.',
	},
	{
		title: 'You see the thing running, not a status report.',
		body: 'Every week there is something you can open and try against your own data. Nothing important gets discovered in the last sprint, when changing direction costs the most.',
	},
	{
		title: 'You get to see how often it is wrong.',
		body: 'Real cases from your world, the answers you would accept, a score that reruns on every change. Nothing ships here because it demoed well once on a Tuesday.',
	},
	{
		title: 'I work inside your setup, not around it.',
		body: 'Your repo, your review cadence, your pace. A two person startup and a team of forty need very different amounts of process, and the handoff should run on yours without me in the room.',
	},
];
---

<Section>
	{}
	<div class="how-head sticky top-36 z-10 pb-6">
		<p class="text-muted mb-2 text-xs font-medium tracking-widest uppercase">How I work</p>
		<h2 class="text-2xl sm:text-3xl">What working with me looks like</h2>
	</div>

	<div class="how-track">
		{}
		<div
			class="how-rail how-rail-fade text-accent mb-4 text-lg leading-6 font-bold tracking-[0.25em]"
			aria-hidden="true"
		>
			<span>0</span>
			<span class="how-num-window h-6 overflow-hidden">
				<span class="how-num-strip block">
					{steps.map((_, i) => (
						<span class="block">{i + 1}</span>
					))}
				</span>
			</span>
		</div>

		<ol class="how-steps space-y-14">
			{
				
			}
			{
				steps.map((step, i) => (
					<li class="how-step relative" style={`z-index:${i + 1}`}>
						<div class="how-step-inner">
							<h3 class="max-w-3xl text-3xl leading-[1.15] sm:text-4xl lg:text-[3.5rem] font-medium">
								{step.title}
							</h3>

							<p class="text-muted mt-6 max-w-2xl text-2xl leading-relaxed">{step.body}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</Section>
