---
/*
  Sliding-pill nav: a cursor tracks the hovered/focused tab and eases between
  them. Links are plain anchors that work with no JS at all — the script only
  adds the moving pill on top; it never intercepts navigation.

  Defaults to sitting under whichever tab matches the current page, and
  returns there on mouseleave/blur rather than disappearing, so the page
  itself always stays visible as "selected" — not just a hover effect.
*/
import { nav } from '../../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<ul class="nav-tabs" data-nav-tabs>
	<li class="nav-tabs__cursor" data-nav-cursor aria-hidden="true"></li>
	{
		nav.map((item) => (
			<li>
				<a
					href={item.href}
					aria-current={isActive(item.href) ? 'page' : undefined}
					data-nav-link
					class="nav-tabs__link"
				>
					{item.label}
				</a>
			</li>
		))
	}
</ul>

<style>
	.nav-tabs {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.125rem;
		padding: 0.25rem;
		border: 1px solid var(--border);
		border-radius: 999px;
	}

	.nav-tabs__cursor {
		position: absolute;
		top: 0.25rem;
		left: 0;
		height: calc(100% - 0.5rem);
		width: 0;
		border-radius: 999px;
		background-color: var(--fg);
		opacity: 0;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.nav-tabs__cursor {
			transition:
				translate 220ms cubic-bezier(0.22, 1, 0.36, 1),
				width 220ms cubic-bezier(0.22, 1, 0.36, 1),
				opacity 150ms ease;
		}
	}

	.nav-tabs__cursor[data-visible] {
		opacity: 1;
	}

	.nav-tabs__link {
		position: relative;
		z-index: 1;
		display: block;
		border-radius: 999px;
		padding: 0.5rem 0.9rem;
		font-size: 0.875rem;
		color: var(--muted);
		transition: color 150ms ease;
	}

	.nav-tabs__link[aria-current='page'] {
		color: var(--fg);
	}

	/* The tab currently under the pill needs the inverse of the pill's fill
	   (--fg) to stay readable, regardless of theme. */
	.nav-tabs__link[data-covered] {
		color: var(--bg);
	}
</style>

<script>
	const container = document.querySelector<HTMLUListElement>('[data-nav-tabs]');
	const cursor = container?.querySelector<HTMLLIElement>('[data-nav-cursor]');

	if (container && cursor) {
		const links = [...container.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
		const active = links.find((link) => link.getAttribute('aria-current') === 'page') ?? null;

		const place = (target: HTMLAnchorElement | null) => {
			for (const link of links) link.removeAttribute('data-covered');

			if (!target) {
				cursor!.removeAttribute('data-visible');
				return;
			}

			const containerRect = container!.getBoundingClientRect();
			const rect = target.getBoundingClientRect();
			cursor!.style.translate = `${rect.left - containerRect.left}px 0`;
			cursor!.style.width = `${rect.width}px`;
			cursor!.setAttribute('data-visible', '');
			target.setAttribute('data-covered', '');
		};

		place(active);

		for (const link of links) {
			link.addEventListener('mouseenter', () => place(link));
			link.addEventListener('focus', () => place(link));
		}

		container.addEventListener('mouseleave', () => place(active));
		container.addEventListener('focusout', (event) => {
			if (!container!.contains(event.relatedTarget as Node)) place(active);
		});
	}
</script>
