---
import { nav } from '../../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<ul class="flex items-center gap-6">
	{
		nav.map((item) => (
			<li>
				<a
					href={item.href}
					aria-current={isActive(item.href) ? 'page' : undefined}
					class="tab text-fg hover:text-accent aria-[current=page]:text-accent text-sm font-semibold transition-colors"
				>
					{/* Per-letter spans get announced a character at a time, so the
					    label is read from here and the roll is decoration. */}
					<span class="sr-only">{item.label}</span>
					<span class="tab-roll" aria-hidden="true">
						{[...item.label].map((char, i) => (
							<span class="tab-letter" style={`--i:${i}`} data-char={char}>
								{char}
							</span>
						))}
					</span>
				</a>
			</li>
		))
	}
</ul>
