---
import Container from '../ui/Container.astro';
import { site, socials } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="border-border mt-auto border-t py-12">
	<Container class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
		<div class="flex flex-col gap-2">
			<p class="text-muted text-sm">
				&copy; {year} {site.name}
			</p>
			<img src="/api/visitor-count.svg" alt="" height="20" class="opacity-70" />
		</div>

		<ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
			{
				socials.map((social) => (
					<li>
						<a
							href={social.href}
							target={social.href.startsWith('http') ? '_blank' : undefined}
							rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
							class="text-muted hover:text-fg text-sm transition-colors"
						>
							{social.label}
						</a>
					</li>
				))
			}
			<li>
				<a href="/rss.xml" class="text-muted hover:text-fg text-sm transition-colors">RSS</a>
			</li>
		</ul>
	</Container>
</footer>
