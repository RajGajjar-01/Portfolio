---
import Container from '../ui/Container.astro';
import { site, socials } from '../../data/site';

const year = new Date().getFullYear();

const wordmarkSize = `min(calc(190vw / ${site.name.length}), 15rem)`;

const letters = [...site.name];

const pills = [
	{ label: site.email, href: `mailto:${site.email}`, external: false },
	...socials
		.filter((s) => s.label !== 'Email')
		.map((s) => ({ label: s.label, href: s.href, external: true })),
];
---

<footer class="mt-auto pt-20 print:hidden">
	{
		
	}
	<div
		aria-hidden="true"
		class="w-full pb-[0.2em] [clip-path:inset(0)]"
		style={`font-size: ${wordmarkSize}`}
	>
		{
			
		}
		<div
			class="font-display wordmark-rise pointer-events-none w-full text-center leading-[1] font-bold whitespace-pre select-none"
			style="color: var(--wordmark)"
		>
			{letters.map((char, i) => <span style={`--i:${i}`}>{char}</span>)}
		</div>
	</div>

	<Container class="pt-4 pb-12">
		<p class="text-muted max-w-prose text-lg">{site.description}</p>

		<div class="mt-6 flex flex-wrap items-center gap-3">
			{
				pills.map((pill) => (
					<a
						href={pill.href}
						target={pill.external ? '_blank' : undefined}
						rel={pill.external ? 'noopener noreferrer' : undefined}
						class="border-border text-muted hover:text-fg focus-visible:text-fg group inline-flex items-center rounded-full border px-4 py-1.5 text-sm transition-colors"
					>
						{pill.label}
						{}
						<svg
							class="w-0 shrink-0 opacity-0 transition-all duration-200 group-hover:ml-1.5 group-hover:w-3 group-hover:opacity-100 group-focus-visible:ml-1.5 group-focus-visible:w-3 group-focus-visible:opacity-100"
							height="12"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M7 7h10v10" />
							<path d="M7 17 17 7" />
						</svg>
					</a>
				))
			}
		</div>

		{}
		<div
			class="border-border mt-12 flex flex-col gap-3 border-t pt-6 sm:flex-row sm:items-center sm:justify-between"
		>
			<p class="text-muted text-sm">&copy; {year} {site.name}. All rights reserved.</p>

			<ul class="text-muted flex items-center gap-5 text-sm">
				<li><a href="/rss.xml" class="hover:text-fg transition-colors">RSS</a></li>
				<li>
					<a href="/sitemap-index.xml" class="hover:text-fg transition-colors">Sitemap</a>
				</li>
			</ul>
		</div>
	</Container>
</footer>
