---
import Container from '../ui/Container.astro';
import NavTabs from './NavTabs.astro';
import { site, nav } from '../../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const initials = site.name
	.split(' ')
	.map((word) => word[0])
	.join(' ');
---

{}
<header class="sticky top-0 z-50 py-3 print:hidden" style="view-transition-name: navbar">
	<Container class="flex items-center gap-3">
		{}
		{}
		<div
			class="header-shell border-border bg-bg mx-auto grid w-full grid-cols-[1fr_auto_1fr] items-center rounded-full border px-4 py-2"
		>
			<a
				href="/"
				class="hover:text-accent font-display grid shrink-0 justify-self-start text-base font-semibold transition-colors"
			>
				<span class="header-logo-full [grid-area:1/1]">{site.name}</span>
				{}
				<span
					class="header-logo-short [grid-area:1/1] tracking-[0.2em] opacity-0"
					aria-hidden="true"
				>
					{initials}
				</span>
			</a>

			<nav aria-label="Main" class="hidden justify-self-center sm:block">
				<NavTabs />
			</nav>

			{}
			<div class="col-start-3 flex items-center justify-self-end">
				<a
					href={`mailto:${site.email}`}
					class="btn-fill bg-fg text-bg -mr-1.5 hidden items-center gap-2 rounded-full px-5 py-2 text-[0.9375rem] font-medium active:scale-[0.98] sm:inline-flex"
				>
					<span>Contact</span>
					<svg
						class="size-4"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M5 12h14M13 6l6 6-6 6"></path>
					</svg>
				</a>

				{}
				<button
					type="button"
					popovertarget="mobile-menu"
					class="text-muted hover:text-fg grid size-9 place-items-center sm:hidden"
					aria-label="Open menu"
				>
					<svg
						class="size-5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</button>
			</div>
		</div>
	</Container>

	<div
		id="mobile-menu"
		popover
		class="border-border bg-bg fixed inset-x-0 top-0 m-0 mt-16 w-full border-b p-6 backdrop:bg-black/40 motion-safe:-translate-y-2 motion-safe:opacity-0 motion-safe:transition motion-safe:transition-discrete motion-safe:duration-200 motion-safe:open:translate-y-0 motion-safe:open:opacity-100 sm:hidden motion-safe:open:starting:-translate-y-2 motion-safe:open:starting:opacity-0"
	>
		<nav aria-label="Mobile">
			<ul class="flex flex-col gap-1">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? 'page' : undefined}
								class="text-muted hover:text-fg aria-[current=page]:text-fg block py-2 font-medium"
							>
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<a
						href={`mailto:${site.email}`}
						class="text-muted hover:text-fg block py-2 font-medium"
					>
						Contact
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>
