---
import Container from '../ui/Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import NavTabs from './NavTabs.astro';
import { site, nav } from '../../data/site';

const path = Astro.url.pathname;
// Mark the section active for its index page and everything nested under it.
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
	class="border-border bg-bg/80 sticky top-0 z-50 border-b backdrop-blur-md"
	style="view-transition-name: header"
>
	<Container class="flex h-16 items-center justify-between gap-4">
		<a href="/" class="hover:text-accent font-display text-lg transition-colors">
			{site.name}
		</a>

		<div class="flex items-center gap-1">
			<nav aria-label="Main" class="hidden sm:block">
				<NavTabs />
			</nav>

			<ThemeToggle />

			{/* Native popover — no JavaScript, no focus-trap code to maintain. */}
			<button
				type="button"
				popovertarget="mobile-menu"
				class="text-muted hover:text-fg grid size-9 place-items-center rounded-full sm:hidden"
				aria-label="Open menu"
			>
				<svg
					class="size-5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</Container>

	<div
		id="mobile-menu"
		popover
		class="border-border bg-bg m-0 mt-16 w-full border-b p-6 sm:hidden"
	>
		<nav aria-label="Mobile">
			<ul class="flex flex-col gap-1">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={isActive(item.href) ? 'page' : undefined}
								class="text-muted hover:text-fg aria-[current=page]:text-fg block py-2 text-lg"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	/* Popovers are top-layer elements, so they need positioning of their own. */
	#mobile-menu {
		position: fixed;
		inset: 0 0 auto 0;
	}

	#mobile-menu::backdrop {
		background-color: rgb(0 0 0 / 0.4);
	}

	@media (prefers-reduced-motion: no-preference) {
		#mobile-menu {
			transition:
				display 200ms allow-discrete,
				overlay 200ms allow-discrete,
				opacity 200ms,
				translate 200ms;
			opacity: 0;
			translate: 0 -0.5rem;
		}

		#mobile-menu:popover-open {
			opacity: 1;
			translate: 0 0;
		}

		/* Entry animation start point. */
		@starting-style {
			#mobile-menu:popover-open {
				opacity: 0;
				translate: 0 -0.5rem;
			}
		}
	}
</style>
