---
// The only JavaScript on the site: ~15 lines, inlined so it costs no request.
---

<button
	id="theme-toggle"
	type="button"
	class="text-muted hover:text-fg hover:border-border grid size-9 place-items-center rounded-full border border-transparent transition-colors"
	aria-label="Toggle colour theme"
>
	<svg
		class="theme-icon-light size-[18px]"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.75"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
		></path>
	</svg>

	<svg
		class="theme-icon-dark size-[18px]"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.75"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
	</svg>
</button>

<style is:global>
	/* Icon visibility matches current light/dark theme state. */
	.theme-icon-dark {
		display: none;
	}

	:root[data-theme='dark'] .theme-icon-dark {
		display: block;
	}

	:root[data-theme='dark'] .theme-icon-light {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .theme-icon-dark {
			display: block;
		}

		:root:not([data-theme='light']) .theme-icon-light {
			display: none;
		}
	}
</style>

<script is:inline>
	function initThemeToggle() {
		const button = document.getElementById('theme-toggle');
		// Astro soft navigation persists this element; only wire it once.
		if (!button || button.dataset.wired) return;
		button.dataset.wired = 'true';

		button.addEventListener('click', () => {
			const root = document.documentElement;
			// With no explicit choice yet, the effective theme is the system one.
			const current =
				root.dataset.theme ||
				(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			const next = current === 'dark' ? 'light' : 'dark';

			root.dataset.theme = next;
			localStorage.setItem('theme', next);
		});
	}

	document.addEventListener('astro:page-load', initThemeToggle);
</script>
