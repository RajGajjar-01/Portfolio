---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a
	class="grid h-44 grid-cols-[auto_1fr] grid-rows-[auto_1fr] overflow-hidden rounded-xl border border-gray-800 bg-[image:var(--gradient-subtle)] font-brand text-lg font-medium no-underline shadow-sm transition-shadow duration-200 ease-in-out hover:shadow-md lg:h-88 lg:rounded-3xl"
	href={`/work/${id}`}
>
	<span
		class="[grid-area:1/1/2/2] z-[1] m-2 rounded-md bg-gray-999 px-4 py-2 text-gray-200 lg:rounded-[0.9375rem]"
	>
		{data.title}
	</span>
	<img
		class="[grid-area:1/1/3/3] h-full w-full object-cover"
		src={data.img}
		alt={data.img_alt || ''}
		loading="lazy"
		decoding="async"
	/>
</a>
