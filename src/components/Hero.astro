---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title } = Astro.props;
const isStart = align === 'start';
const textAlignClasses = isStart ? 'text-center lg:text-left' : 'text-center';
const marginClasses = isStart ? 'mx-auto lg:mx-0' : 'mx-auto';
---

<div class:list={['flex flex-col gap-4 text-lg lg:text-xl', textAlignClasses]}>
	<div class="flex flex-col gap-2">
		<h1 class:list={['max-w-[37ch] text-3xl text-gray-0 lg:text-5xl', marginClasses]}>{title}</h1>
		{tagline && <p class:list={['max-w-[37ch]', marginClasses]}>{tagline}</p>}
	</div>
	<slot />
</div>
