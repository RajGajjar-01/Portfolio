---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside
	class="flex flex-col items-center gap-12 border-t border-b border-gray-800 bg-gray-999/40 px-6 py-20 shadow-sm lg:flex-row lg:flex-wrap lg:justify-between lg:p-30"
>
	<h2 class="max-w-[15ch] text-center text-xl lg:text-left lg:text-3xl">
		Interested in working together?
	</h2>
	<CallToAction href="mailto:me@example.com">
		Send Me a Message
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>
