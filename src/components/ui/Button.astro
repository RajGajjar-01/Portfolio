---
interface Props {
	href: string;
	variant?: 'solid' | 'outline' | 'ghost';
	class?: string;
	// Saves the file instead of navigating, which also keeps the page transition out of it.
	download?: boolean;
}

const { href, variant = 'solid', class: className = '', download = false } = Astro.props;

const external = !href.startsWith('/') && !href.startsWith('#');

const base =
	'inline-flex items-center justify-center rounded-full px-5 py-2.5 text-md font-medium transition active:scale-[0.98]';

const variantClass = {
	solid: 'btn-fill bg-fg text-bg',
	outline: 'btn-fill border-border text-fg border bg-transparent hover:border-accent',
	ghost: 'text-muted bg-transparent hover:text-fg',
}[variant];
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	download={download || undefined}
	class:list={[base, variantClass, className]}
>
	<span><slot /></span>
</a>
