---
interface Props {
	href: string;
	variant?: 'solid' | 'outline' | 'ghost';
	class?: string;
}

const { href, variant = 'solid', class: className = '' } = Astro.props;

// Treat anything that isn't a root-relative path or hash as off-site.
const external = !href.startsWith('/') && !href.startsWith('#');

const base =
	'inline-flex items-center gap-2 px-5 py-2.5 text-md font-medium transition active:scale-[0.98]';

// Solid/outline reuse the fg/bg pair so "solid" and "outline:hover" land on the same colors.
const variantClass = {
	solid: 'bg-fg text-bg hover:bg-accent hover:text-white',
	outline: 'border-border text-fg border bg-transparent hover:border-fg hover:bg-fg hover:text-bg',
	ghost: 'text-muted bg-transparent hover:text-fg',
}[variant];
---

<a
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
	class:list={[base, variantClass, className]}
>
	<slot />
	{
		external && (
			<svg
				class="size-3.5 opacity-60"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M7 17 17 7M9 7h8v8" />
			</svg>
		)
	}
</a>
