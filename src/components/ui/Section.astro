---
import Container from './Container.astro';

interface Props {
	title?: string;
	/** Small label rendered above the title. */
	eyebrow?: string;
	/** Optional link rendered opposite the title, e.g. "All work". */
	action?: { label: string; href: string };
	id?: string;
	width?: 'default' | 'wide' | 'prose';
	class?: string;
}

const { title, eyebrow, action, id, width = 'default', class: className = '' } = Astro.props;
---

<section id={id} class:list={['py-20 sm:py-28', className]}>
	<Container width={width}>
		{
			(title || eyebrow) && (
				<header class="reveal mb-12 flex flex-wrap items-end justify-between gap-4">
					<div>
						{eyebrow && (
							<p class="text-muted mb-2 font-mono text-xs tracking-widest uppercase">
								{eyebrow}
							</p>
						)}
						{title && <h2 class="text-3xl sm:text-4xl">{title}</h2>}
					</div>

					{action && (
						<a
							href={action.href}
							class="text-muted hover:text-fg group text-sm transition-colors"
						>
							{action.label}
							<span
								class="inline-block transition-transform group-hover:translate-x-0.5"
								aria-hidden="true"
							>
								&nbsp;&rarr;
							</span>
						</a>
					)}
				</header>
			)
		}

		<slot />
	</Container>
</section>
