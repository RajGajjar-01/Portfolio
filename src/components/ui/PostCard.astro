---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import { formatDate, isoDate, tagSlug, type Post } from '../../lib/content';

interface Props {
	post: Post;
	
	eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { title, description, pubDate, cover, coverAlt, tags, draft } = post.data;

const isSvgCover = cover?.format === 'svg';

---

<article class="reveal group">
	<a href={`/blog/${post.id}`} class="block" aria-label={`Read post: ${title}`}>
		{
			cover && (
				<div class="relative mb-5">
					<div class="border-border bg-surface overflow-hidden rounded-none border">
						{isSvgCover ? (
							<img
								src={cover.src}
								alt={coverAlt}
								loading={eager ? 'eager' : 'lazy'}
								fetchpriority={eager ? 'high' : 'auto'}
								class="aspect-video w-full object-cover"
							/>
						) : (
							<Image
								src={cover}
								alt={coverAlt}
								width={800}
								height={450}
								loading={eager ? 'eager' : 'lazy'}
								fetchpriority={eager ? 'high' : 'auto'}
								class="aspect-video w-full object-cover"
							/>
						)}
					</div>
				</div>
			)
		}

		<div class="text-muted mb-2 flex items-center gap-3 font-mono text-xs">
			<time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
			{draft && <span class="text-accent">Draft</span>}
		</div>

		<h3 class="group-hover:text-accent mb-2 text-xl transition-colors">
			{title}
		</h3>

		<p class="text-muted max-w-prose text-sm leading-relaxed">{description}</p>
	</a>

	{
		tags.length > 0 && (
			<div class="mt-4 flex flex-wrap gap-1.5">
				{tags.map((tag) => (
					<Tag href={`/blog/tag/${tagSlug(tag)}`}>{tag}</Tag>
				))}
			</div>
		)
	}
</article>
