---
import Tag from './Tag.astro';
import { formatDate, isoDate, tagSlug, type Post } from '../../lib/content';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
---

<article class="reveal border-border group border-t py-8 first:border-t-0 first:pt-0">
	<a href={`/blog/${post.id}`} class="block">
		<div class="text-muted mb-2 flex items-center gap-3 font-mono text-xs">
			<time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
			{draft && <span class="text-accent">Draft</span>}
		</div>

		<h3 class="group-hover:text-accent mb-2 text-xl transition-colors">
			{title}
		</h3>

		<p class="text-muted max-w-prose text-sm leading-relaxed">{description}</p>
	</a>

	{
		tags.length > 0 && (
			<div class="mt-4 flex flex-wrap gap-1.5">
				{tags.map((tag) => (
					<Tag href={`/blog/tag/${tagSlug(tag)}`}>{tag}</Tag>
				))}
			</div>
		)
	}
</article>
