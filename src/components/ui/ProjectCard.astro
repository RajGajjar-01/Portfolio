---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import type { Project } from '../../lib/content';

interface Props {
	project: Project;
	/** The first card is above the fold, so it must not be lazy-loaded. */
	eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, summary, cover, coverAlt, tags, year, role } = project.data;
---

<article class="reveal group">
	<a href={`/projects/${project.id}`} class="block" aria-label={`View project: ${title}`}>
		{
			cover ? (
				<div class="border-border mb-5 overflow-hidden rounded-none border bg-black transition-[border-radius] duration-300 group-hover:rounded-2xl">
					<Image
						src={cover}
						alt={coverAlt}
						width={800}
						height={500}
						loading={eager ? 'eager' : 'lazy'}
						fetchpriority={eager ? 'high' : 'auto'}
						class="aspect-[8/5] w-full object-contain transition-transform duration-500 group-hover:scale-[1.02]"
					/>
				</div>
			) : (
				<div class="border-border bg-surface mb-5 aspect-[8/5] rounded-xl border" />
			)
		}

		<div class="text-muted mb-2 flex items-center gap-2 font-mono text-xs">
			<span>{year}</span>
			{role && <span class="before:mr-2 before:content-['·']">{role}</span>}
		</div>

		<h3 class="group-hover:text-accent mb-2 text-xl transition-colors">
			{title}
		</h3>

		<p class="text-muted max-w-prose text-sm leading-relaxed">{summary}</p>
	</a>

	{
		tags.length > 0 && (
			<div class="mt-4 flex flex-wrap gap-1.5">
				{tags.map((tag) => (
					<Tag>{tag}</Tag>
				))}
			</div>
		)
	}
</article>
