{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"compatibility_date": "2026-08-16",
	"compatibility_flags": ["nodejs_compat"],

	// "main" omitted; @astrojs/cloudflare outputs dist/server/wrangler.json on build.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},

	// KV namespace auto-provisioned by Wrangler on deploy for visitor counter.
	"kv_namespaces": [
		{
			"binding": "VISITOR_COUNT"
		}
	]
}
